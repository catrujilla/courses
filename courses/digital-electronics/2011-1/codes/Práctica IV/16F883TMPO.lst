001E   0FA2           00095         INCFSZ  numeroB,f       
001F   2???           00096     GOTO        LOOP1           
0020   0FA4           00097         INCFSZ  numeroC,f
0021   2???           00098     GOTO        LOOP1
0022   0FA3           00099     INCFSZ      resultado,f
0023   2???           00100     GOTO        LOOP1
0024   0008           00101         RETURN
                      00102 
                      00103 ;Decidimos si el pulser está pulsado o no
0025                  00104 DECISION
0025   1886           00105         BTFSC   PORTB,1 ; Testea si está prendido o apagado.
0026   2???           00106         Goto PRENDER2 ;Prende
0027   2???           00107         Goto APAGAR2 ;Apaga
                      00108         
0028                  00109 PRENDER2
0028   30FF           00110         MOVLW B'11111111' ;255 EN W
0029   0087           00111         MOVWF PORTC               ;Lo pongo en puerto C
002A   0008           00112         RETURN  ;vuelve
                      00113 
002B                  00114 APAGAR2
002B   3000           00115         MOVLW d'0' ;0 EN W
002C   0087           00116         MOVWF PORTC               ;Lo pongo en puerto C
002D   0008           00117         RETURN ;vuelve
                      00118 
                      00119 
                      00120 MAIN_PROG       CODE
                      00121 
0000                  00122 Inicio
                      00123 
0000   1683 1703      00124         BANKSEL ANSELH  ; Me voy para el banco del ANSELH
0002   3000           00125         MOVLW B'00000000'; Todos los pines son digitales
Message[302]: Register in operand not in bank 0.  Ensure that bank bits are correct.
0003   0089           00126         MOVWF ANSELH  ;Lo meto en este registro
0004   1683 1303      00127         BANKSEL TRISB ; Me voy para el banco del trisb
0006   3002           00128         MOVLW B'00000010'; Todos los pines son salidas, excepto RB1
Message[302]: Register in operand not in bank 0.  Ensure that bank bits are correct.
0007   0086           00129         MOVWF TRISB ;Lo meto en este registro
0008   3000           00130         MOVLW D'0'
Message[302]: Register in operand not in bank 0.  Ensure that bank bits are correct.
0009   0087           00131         MOVWF TRISC ;Lo meto en este registro
000A   1283 1303      00132         BANKSEL PORTB ;Me voy para el banco del puerto b
000C   0186           00133         CLRF PORTB ;Borro el puerto
000D   0187           00134         CLRF PORTC  ;Borro el puerto
                      00135 
000E                  00136 Principal       
000E   2???           00137         CALL Cinco_Segundos ;invoco Rutina
000F   2???           00138         CALL DECISION           ;invoco Rutina
0010   2???           00139         GOTO Principal          ;Ciclo principal del programa
                      00140 
28E2 3EFF             00141         END 
