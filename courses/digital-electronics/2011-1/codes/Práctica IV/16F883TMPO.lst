                      00018 ;                                                                     *
                      00019 ;    Notes:   Este programa cada dos segundos verifica el estado de                                     
                                                *
                      00020 ;             un pin y establece el estado de un puerto a partir del                                    
                                                *
                      00021 ;             pin.                                                        *
                      00022 ;                                                                     *
                      00023 ;                                                                     *
                      00024 ;**********************************************************************
                      00025 
                      00026     list        p=16f883    ; list directive to define processor
                      00027     #include    <p16f883.inc>   ; processor specific variable definitions
