                      00054 RESET_VECTOR    CODE    0x0000  ; processor reset vector
0000   0000           00055     nop
0001   2???           00056     goto    Inicio               ; go to beginning of program
                      00057 
                      00058 INT_VECTOR      CODE    0x0004  ; interrupt vector location
                      00059 
0004                  00060 Interrupcion
                      00061 
0004   00??           00062     movwf   w_temp          ; save off current W register contents
0005   0803           00063     movf    STATUS,w        ; move status register into W register
0006   00??           00064     movwf   status_temp     ; save off contents of STATUS register
0007   080A           00065     movf    PCLATH,w        ; move pclath register into w register
0008   00??           00066     movwf   pclath_temp     ; save off contents of PCLATH register
                      00067 
                      00068 ; isr code can go here or be located as a call subroutine elsewhere
                      00069 
0009   08??           00070     movf    pclath_temp,w   ; retrieve copy of PCLATH register
000A   008A           00071     movwf   PCLATH          ; restore pre-isr PCLATH register contents
000B   08??           00072     movf    status_temp,w   ; retrieve copy of STATUS register
000C   0083           00073     movwf   STATUS          ; restore pre-isr STATUS register contents
000D   0E??           00074     swapf   w_temp,f
000E   0E??           00075     swapf   w_temp,w        ; restore pre-isr W register contents
000F   0009           00076     retfie                  ; return from interrupt
                      00077 
                      00078 ;Rutina de espera de 2 segundos
0010                  00079 Cinco_Segundos
0010   0000           00080         NOP                                     ;Esta intruccion no hace nada...
0011   30FF           00081         MOVLW   D'255'  ; Cargar este valor en W register (como valor Binario)
0012   00A1           00082         MOVWF   numeroA         ; cargar el valor de W en numeroA
0013   30F0           00083         MOVLW   D'240'  ; Cargar este valor en W register (como valor Binario)
0014   00A3           00084         MOVWF   resultado               ; cargar el valor de W en numeroA
0015   3000           00085         MOVLW   D'0'
0016   00A2           00086     MOVWF       numeroB         ; cargar el valor de W en numeroB
0017   30C0           00087         MOVLW   D'192'
0018   00A4           00088         MOVWF   numeroC         ; cargar el valor de W en numeroC
0019   0000           00089     NOP
001A                  00090 LOOP1                                   ; Ciclo para esperar 5seg
001A   0BA1           00091         DECFSZ  numeroA,f       
001B   2???           00092         GOTO    LOOP1
001C   0000           00093         NOP                     
001D   14A1           00094         BSF             numeroA,1       
