                      00029 ; '__CONFIG' directive is used to embed configuration data within .asm file.
                      00030 ; The labels following the directive are located in the respective .inc file.
                      00031 ; See respective data sheet for additional information on configuration word.
                      00032 
2007   28E2           00033     __CONFIG    _CONFIG1, _LVP_OFF & _FCMEN_ON & _IESO_OFF & _BOR_OFF & _CPD_OFF & _CP_OFF & _MCLRE_ON &
                             _PWRTE_ON & _WDT_OFF & _HS_OSC
2008   3EFF           00034     __CONFIG    _CONFIG2, _WRT_OFF & _BOR21V
                      00035 
                      00036 ;***** VARIABLE DEFINITIONS (examples)
  00000021            00037 numeroA         equ 0x21        ; Asignacion de nombre numeroA al resgistro 0x21
  00000022            00038 numeroB         equ 0x22        ; Asignacion de nombre numeroB al resgistro 0x22
  00000023            00039 resultado       equ 0x23        ; Asignacion de nombre resultado al resgistro 0x23
  00000024            00040 numeroC         equ 0x24        ; Asignacion de nombre resultado al resgistro 0x24
                      00041 
